# syntax=docker/dockerfile:1.7
# ────────────────────────────────────────────────────────────
# patient-router · dev-образ (hot reload)
# Зависимости ставятся отдельно от кода, чтобы монтировать
# исходники без потери слоёв.
# ────────────────────────────────────────────────────────────

FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.12.13 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    TZ=Europe/Moscow \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

RUN apt-get update \
 && apt-get install -y --no-install-recommends tzdata curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# манифесты → слой с зависимостями (включая dev-группу).
# Копируем манифесты первыми, но пакет app нужен уже на этом шаге —
# иначе uv не сможет собрать его (в отличие от --no-install-project).
COPY pyproject.toml uv.lock ./
COPY app ./app
COPY doc_processing ./doc_processing
COPY alembic ./alembic
COPY alembic.ini ./alembic.ini
COPY config ./config
COPY scripts ./scripts
COPY README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen

# Рантайм наследует dev-зависимости и инструменты сборочного слоя.
FROM builder AS runtime

RUN useradd --create-home --uid 10001 appuser
COPY --from=builder --chown=appuser:appuser /app/app /app/app
COPY --from=builder --chown=appuser:appuser /app/doc_processing /app/doc_processing
COPY --from=builder --chown=appuser:appuser /app/scripts /app/scripts

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
