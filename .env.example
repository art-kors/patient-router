# patient-router · пример для локальной разработки
# Реальные секреты НЕ коммитить — значения для CI/CD задаются отдельно.

# --- БД ---
POSTGRES_DB=patient_router
POSTGRES_USER=pr
POSTGRES_PASSWORD=pr_local_dev
POSTGRES_PORT=5433

# --- приложение ---
APP_PORT=8000
ENVIRONMENT=prod
DEBUG=false
LOG_LEVEL=INFO

# true = модельное время (демо сценариев за секунды)
USE_MODEL_CLOCK=false

# --- миграции ---
# Пусто = схема из DSN (в docker это public).
# Задаётся, чтобы гонять миграции в отдельной схеме, не задевая чужие таблицы.
ALEMBIC_TARGET_SCHEMA=

TZ=Europe/Moscow