# patient-router · пример для локальной разработки
# Реальные секреты НЕ коммитить — значения для CI/CD задаются отдельно.

# Все порты обязательны для Compose, включая сервисы вне выбранного профиля.
# Перед запуском выберите свободные порты: .env не резервирует их.

# --- БД ---
POSTGRES_DB=patient_router
POSTGRES_USER=pr
POSTGRES_PASSWORD=pr_local_dev
POSTGRES_PORT=5433

# --- приложение ---
APP_PORT=8000
# dev-сервис (профиль dev) слушает свой порт, чтобы не драться с APP_PORT
DEV_PORT=8001
# demo-сервис (профиль demo) — модельное время, порт задаётся явно.
# USE_MODEL_CLOCK у него задано жёстко "true" в compose и переменной не
# подчиняется: sudo сбрасывает env, и sudo -E на машине жюри недоступен.
DEMO_PORT=8010
ENVIRONMENT=prod
DEBUG=false
LOG_LEVEL=INFO

# true = модельное время (демо сценариев за секунды)
# Влияет только на app и dev. Для показа демо используйте сервис demo.
USE_MODEL_CLOCK=false

# --- миграции ---
# Пусто = схема из DSN (в docker это public).
# Задаётся, чтобы гонять миграции в отдельной схеме, не задевая чужие таблицы.
ALEMBIC_TARGET_SCHEMA=

TZ=Europe/Moscow